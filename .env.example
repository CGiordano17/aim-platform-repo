# Copy to .env and fill in with your Supabase project's real values
# (Supabase dashboard → Project Settings → API). Never commit .env.

# Public — safe to expose to the browser (Supabase enforces access via RLS,
# not by keeping these secret).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, bypasses RLS. Used only in server components /
# route handlers / server actions. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used server-side for the open-text Readiness-assessment scoring call
# (PRD §6.2 — this must run server-side in production, never client-side).
ANTHROPIC_API_KEY=your-anthropic-api-key

# SSO (PRD §7, resolved: support both email/password and SSO). Configure the
# actual OAuth apps in the Supabase dashboard (Authentication → Providers) —
# these env vars are not required by Supabase Auth itself, but Google/
# Microsoft require you to register a redirect URI there:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
