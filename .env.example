# Copy to .env and fill in with your Supabase project's real values
# (Supabase dashboard → Project Settings → API). Never commit .env.

# Public — safe to expose to the browser (Supabase enforces access via RLS,
# not by keeping these secret).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server-side only, bypasses RLS. Used only in server components /
# route handlers / server actions. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used server-side for the open-text Readiness-assessment scoring call
# (PRD §6.2 — this must run server-side in production, never client-side).
ANTHROPIC_API_KEY=your-anthropic-api-key

# SSO (PRD §7, resolved: support both email/password and SSO). Enterprise
# SSO is vendor-agnostic by design — the login page's "Sign in with company
# SSO" form calls supabase.auth.signInWithSSO({ domain }), which resolves to
# whichever SAML/OIDC IdP (Okta, Entra ID, OneLogin, PingFederate, anything)
# that enterprise registered for their own email domain via the Supabase
# CLI (`supabase sso add --type saml --metadata-url ... --domains
# theirdomain.com`) — requires a Supabase Team/Enterprise plan, not the free
# tier. We never choose the IdP vendor; each enterprise brings their own.
# Microsoft personal/work-account OAuth is also offered as a convenience
# sign-in, separate from the enterprise SSO path above; deliberately no
# Google button (many enterprises explicitly avoid Google) — register the
# Microsoft OAuth app in the Supabase dashboard if you want it, redirect URI:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback

# Notification delivery (push-style Nudges) — Slack and/or Microsoft Teams,
# not Google Chat, per the client's explicit steer. Only fill in the one(s)
# you're actually connecting; the registry (src/lib/integrations/registry.ts)
# only dispatches through providers marked "connected" in the Integrations tab.

# Slack: create an app at api.slack.com/apps with bot scopes chat:write and
# users:read.email, enable Interactivity, point its Request URL at
# <your-domain>/api/webhooks/slack.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret

# Microsoft Teams: register an Azure Bot / Entra app (Azure Portal or Teams
# Toolkit) with Graph Application permission User.Read.All (admin-consented),
# Teams channel enabled, messaging endpoint <your-domain>/api/webhooks/teams.
# The bot also needs org-wide installation via a Teams app package — a
# Teams Admin Center action, not something this codebase does.
TEAMS_TENANT_ID=your-azure-tenant-id
TEAMS_APP_ID=your-bot-app-id
TEAMS_APP_PASSWORD=your-bot-client-secret

# Protects /api/cron/dispatch-nudges — Vercel sends this automatically as a
# Bearer header when a Vercel Cron Job calls the route. Generate any random
# string (e.g. `openssl rand -hex 32`) and set it as a Vercel project env
# var of the same name.
CRON_SECRET=your-random-cron-secret

